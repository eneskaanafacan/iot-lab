# Backend HTTP portu
PORT=8080

# MongoDB baglanti dizgisi
MONGO_URL=mongodb://localhost:27017/iot-dashboard

# JWT imzalama sirri (en az 256-bit / 32 byte, base64 onerilir)
JWT_SECRET=changeme

# Telegram bildirim botu token'i (@BotFather uzerinden alinir)
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN

# Telegram bildirimlerinin gonderilecegi sohbet/kanal id'si
TELEGRAM_CHAT_ID=

# Frontend'in yayinda calisacagi ek CORS origin'i (ornek: https://example.com)
CORS_ALLOWED_ORIGIN=

# Uygulama ilk ayaga kalktiginda olusturulan varsayilan admin hesabinin sifresi
DEFAULT_ADMIN_PASSWORD=changeme
